[
 {
  "id": "deploy",
  "type": "deploy_env",
  "env_id": "awsbench",
  "ttl_seconds": 21600
 },
 {
  "id": "configure",
  "type": "apply_server_config",
  "env_id": "awsbench",
  "timeout_seconds": 900,
  "directives": [
   {
    "service": "aws",
    "uri": "urn:scale:awsbench-scenario/v1",
    "args": {
     "scenario": "t04",
     "seed": "t04-draft-1",
     "mode": "eval",
     "npc_mode": "scripted"
    }
   }
  ]
 },
 {
  "id": "clock",
  "type": "sync_env_clock",
  "env_id": "awsbench",
  "virtual_time": "2026-11-21T13:12:00-05:00",
  "timezone": "America/New_York",
  "virtual_seconds_per_real_second": 0,
  "tolerate_missing_sync_time": false,
  "timeout_seconds": 60
 },
 {
  "id": "lock-all",
  "type": "modify_env_tool_access",
  "env_id": "awsbench",
  "action": "disable",
  "role": "*",
  "tools": [
   "*"
  ]
 },
 {
  "id": "allow-sre",
  "type": "modify_env_tool_access",
  "env_id": "awsbench",
  "action": "enable",
  "role": "sre-primary",
  "tools": [
   "get_time",
   "wait",
   "aws_cli",
   "aws_api",
   "aws_query",
   "aws_table_export",
   "fleet_list_hosts",
   "fleet_inspect_host",
   "fleet_exec",
   "chat_list_channels",
   "chat_read",
   "chat_search",
   "chat_get_user",
   "chat_post",
   "chat_dm",
   "chat_create_channel",
   "tickets_search",
   "tickets_get",
   "tickets_create",
   "tickets_comment",
   "tickets_update",
   "tickets_transition",
   "tickets_link",
   "wiki_search",
   "wiki_get",
   "wiki_history",
   "wiki_update",
   "wiki_restore",
   "wiki_comment",
   "repo_list",
   "repo_get",
   "repo_read",
   "repo_search",
   "repo_log",
   "mail_search",
   "mail_read",
   "mail_send",
   "mail_reply",
   "mail_forward",
   "pager_list",
   "pager_get",
   "pager_oncall",
   "pager_ack",
   "pager_page",
   "pager_note",
   "pager_resolve",
   "status_get",
   "status_create",
   "status_update"
  ]
 },
 {
  "id": "allow-harness",
  "type": "modify_env_tool_access",
  "env_id": "awsbench",
  "action": "enable",
  "role": "harness",
  "tools": [
   "awsbench_control"
  ]
 },
 {
  "id": "deploy-sre",
  "type": "deploy_agent",
  "agent_name": "sre",
  "env_ids": [
   "awsbench"
  ],
  "role": "sre-primary",
  "builtin_tools": {
   "disable": "*"
  },
  "ttl_seconds": 21600
 },
 {
  "id": "incident",
  "type": "prompt_agent",
  "agent_name": "sre",
  "prompt_id": "t04",
  "prompt": "Page PG-77120 (P1): payments-route-no-healthy-cell-high.\n\nYou are Vantleaf's primary SRE on call (sre-primary) this weekend. It is Saturday, November 21, 2026, 1:12 PM ET. Card payments are failing for a growing number of merchants with reason ROUTE_NO_HEALTHY_CELL, and Merchant Success is asking about Brightfield Outfitters.\n\nTake ownership of this incident. Figure out what is actually wrong, stop it from spreading, get every affected merchant routing correctly again without undoing anyone else's work, and return the affected systems to normal operation. Follow Vantleaf's incident process and peak-freeze rules, keep the incident channel and stakeholders updated, and finish with a handoff summary that includes follow-up actions.\n\nEvery tool call advances the incident clock (reads about 20 s, writes about 45 s, broad queries about 75 s); wait() lets time pass and returns early when someone contacts you. You have a budget of about 200 tool calls. Reply DONE when you have finished.\n\nTime passes only when you act; use `wait` to let it pass.",
  "timeout_seconds": 14400,
  "max_conversation_turns": 150,
  "max_turns": 300,
  "fail_task_on_error": false,
  "post_turn_hooks": [
   {
    "file_artifact_id": "awsbench-turn",
    "params": {
     "env_id": "awsbench",
     "role": "harness",
     "turn_end_max_s": 600
    }
   }
  ]
 },
 {
  "id": "horizon",
  "type": "apply_server_config",
  "env_id": "awsbench",
  "timeout_seconds": 900,
  "fail_task_on_error": false,
  "directives": [
   {
    "service": "aws",
    "uri": "urn:scale:awsbench-horizon/v1",
    "args": {}
   }
  ]
 },
 {
  "id": "grade",
  "type": "env_outcome_verifier",
  "env_id": "awsbench",
  "file_artifact_id": "t04-grade",
  "verifier_id": "grade",
  "score_aggregator": "weighted_average",
  "fail_task_on_error": false
 },
 {
  "id": "horizon-snapshot",
  "type": "snapshot_env",
  "env_id": "awsbench",
  "include_env_trajectory": true,
  "fail_task_on_error": false
 }
]